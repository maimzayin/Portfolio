<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mai Moutaz — Events Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --cream: #FAF7F2;
    --ink: #1A0A0A;
    --red: #8B1A1A;
    --red-deep: #6B1212;
    --red-light: #F5E8E8;
    --red-mid: #C47070;
    --warm-gray: #8C8580;
    --card-bg: #FFFFFF;
    --border: rgba(139,26,26,0.12);
    --section-gap: 90px;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--ink); overflow-x: hidden; }

  nav { position: sticky; top: 0; z-index: 100; display: flex; justify-content: space-between; align-items: center; padding: 1.2rem 4rem; background: var(--cream); border-bottom: 1px solid var(--border); }
  .nav-logo { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; color: var(--ink); text-decoration: none; }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a { font-size: 0.82rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--warm-gray); text-decoration: none; transition: color 0.2s; }
  .nav-links a:hover { color: var(--red); }
  .nav-cta { background: var(--ink) !important; color: var(--cream) !important; padding: 0.5rem 1.2rem; border-radius: 100px; }
  .nav-cta:hover { background: var(--red) !important; }

  .hero { min-height: 92vh; display: grid; grid-template-columns: 1fr 1fr; align-items: center; padding: 4rem; gap: 4rem; }
  .hero-tag { display: inline-flex; align-items: center; gap: 0.5rem; background: var(--red-light); color: var(--red); font-size: 0.78rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.4rem 1rem; border-radius: 100px; margin-bottom: 1.5rem; }
  .hero-tag span { width: 6px; height: 6px; background: var(--red); border-radius: 50%; display: inline-block; }
  .hero h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.8rem, 4.5vw, 5rem); line-height: 1.05; font-weight: 700; margin-bottom: 1.5rem; }
  .hero h1 em { font-style: italic; color: var(--red); font-weight: 400; }
  .hero-desc { font-size: 1rem; line-height: 1.75; color: var(--warm-gray); max-width: 460px; margin-bottom: 1.5rem; }
  .event-types { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 2.5rem; }
  .event-types span { background: var(--red-light); color: var(--red); font-size: 0.75rem; font-weight: 500; padding: 0.3rem 0.8rem; border-radius: 100px; border: 1px solid rgba(139,26,26,0.2); }
  .hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-primary { background: var(--red); color: white; padding: 0.9rem 2rem; border-radius: 100px; font-size: 0.9rem; font-weight: 500; text-decoration: none; transition: background 0.2s, transform 0.15s; display: inline-flex; align-items: center; gap: 0.5rem; }
  .btn-primary:hover { background: var(--red-deep); transform: translateY(-1px); }
  .btn-secondary { background: transparent; color: var(--ink); padding: 0.9rem 2rem; border-radius: 100px; font-size: 0.9rem; font-weight: 500; text-decoration: none; border: 1.5px solid var(--border); transition: border-color 0.2s, color 0.2s, transform 0.15s; display: inline-flex; align-items: center; gap: 0.5rem; }
  .btn-secondary:hover { border-color: var(--red); color: var(--red); transform: translateY(-1px); }

  .hero-visual { position: relative; display: flex; align-items: center; justify-content: center; min-height: 520px; }
  .hero-card-main { background: var(--ink); border-radius: 24px; width: 300px; height: 380px; display: flex; flex-direction: column; justify-content: flex-end; padding: 2rem; position: relative; overflow: hidden; z-index: 2; }
  .hero-card-main-bg { position: absolute; inset: 0; background: linear-gradient(160deg, #3A1010 0%, #1A0A0A 60%); border-radius: 24px; }
  .avatar-placeholder { position: absolute; top: 2rem; left: 50%; transform: translateX(-50%); width: 100px; height: 100px; border-radius: 50%; background: var(--red-light); display: flex; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 700; color: var(--red); z-index: 3; }
  .hero-card-content { position: relative; z-index: 3; }
  .hero-card-content h3 { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: white; margin-bottom: 0.2rem; }
  .hero-card-content p { font-size: 0.78rem; color: var(--red-mid); margin-bottom: 1rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; }
  .hero-card-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .hero-card-tags span { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.7); font-size: 0.72rem; padding: 0.25rem 0.6rem; border-radius: 100px; }
  .hero-card-float { position: absolute; background: white; border-radius: 16px; padding: 1rem 1.25rem; box-shadow: 0 8px 32px rgba(0,0,0,0.1); }
  .float-1 { top: 2rem; right: -1rem; display: flex; align-items: center; gap: 0.75rem; }
  .float-1 .dot { width: 36px; height: 36px; background: var(--red-light); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
  .float-1 .info p:first-child { font-size: 0.75rem; color: var(--warm-gray); }
  .float-1 .info p:last-child { font-size: 1rem; font-weight: 500; color: var(--ink); }
  .float-2 { bottom: 3rem; left: -2rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .float-2 .label { font-size: 0.72rem; color: var(--warm-gray); }
  .float-2 .badges { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .float-2 .badge { background: var(--red-light); color: var(--red); font-size: 0.72rem; padding: 0.25rem 0.6rem; border-radius: 100px; font-weight: 500; }

  .stats-bar { padding: 2.5rem 4rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); display: flex; justify-content: center; }
  .stat-item { text-align: center; padding: 0 3.5rem; border-right: 1px solid var(--border); }
  .stat-item:last-child { border-right: none; }
  .stat-number { font-family: 'Playfair Display', serif; font-size: 2.5rem; font-weight: 700; color: var(--red); line-height: 1; margin-bottom: 0.3rem; }
  .stat-label { font-size: 0.78rem; color: var(--warm-gray); text-transform: uppercase; letter-spacing: 0.08em; }

  .section { padding: var(--section-gap) 4rem; }
  .section-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3rem; }
  .section-label { font-size: 0.78rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red); margin-bottom: 0.5rem; }
  .section-title { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 3vw, 2.8rem); font-weight: 700; line-height: 1.1; }
  .section-title em { font-style: italic; color: var(--warm-gray); font-weight: 400; }

  .work-card { background: white; border: 1px solid var(--border); border-radius: 20px; padding: 2rem 2rem 2rem 2.5rem; margin-bottom: 1.5rem; border-left: 4px solid var(--red); }
  .work-card-header { display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1rem; }
  .work-icon { width: 48px; height: 48px; border-radius: 12px; background: var(--red-light); display: flex; align-items: center; justify-content: center; font-size: 1.3rem; flex-shrink: 0; }
  .work-card-meta h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; color: var(--ink); margin-bottom: 0.2rem; }
  .work-card-meta .org { font-size: 0.85rem; color: var(--red); font-weight: 500; margin-bottom: 0.3rem; }
  .work-card-meta .date { font-size: 0.78rem; color: var(--warm-gray); }
  .work-tag { display: inline-block; background: var(--red-light); color: var(--red); font-size: 0.7rem; font-weight: 500; padding: 0.2rem 0.7rem; border-radius: 100px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 1rem; }
  .work-desc { font-size: 0.9rem; color: var(--warm-gray); line-height: 1.7; margin-bottom: 1rem; }
  .work-events-list { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
  .work-events-list span { background: var(--cream); border: 1px solid var(--border); color: var(--ink); font-size: 0.75rem; padding: 0.25rem 0.75rem; border-radius: 100px; }
  .work-bullets { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .work-bullets li { font-size: 0.88rem; color: var(--ink); line-height: 1.6; padding-left: 1rem; position: relative; }
  .work-bullets li::before { content: ''; position: absolute; left: 0; top: 0.58em; width: 5px; height: 5px; background: var(--red); border-radius: 50%; }

  .events-section { padding: var(--section-gap) 4rem; background: #FAF0F0; }
  .events-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .event-card { background: white; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; }
  .event-card:hover { transform: translateY(-3px); box-shadow: 0 12px 40px rgba(139,26,26,0.1); }
  .event-card-img { width: 100%; aspect-ratio: 16/10; background: var(--red-light); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem; }
  .event-card-img svg { width: 28px; height: 28px; color: var(--red-mid); }
  .event-card-img p { font-size: 0.75rem; color: var(--red-mid); font-weight: 500; }
  .event-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .event-card-body { padding: 1.1rem 1.25rem 1.25rem; }
  .event-tag { display: inline-block; background: var(--red-light); color: var(--red); font-size: 0.68rem; font-weight: 500; padding: 0.2rem 0.6rem; border-radius: 100px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.5rem; }
  .event-tag.blue { background: #E8EDF5; color: #2E5FA3; }
  .event-tag.green { background: #EAF0EA; color: #2E6E3A; }
  .event-tag.purple { background: #EDE8F0; color: #5A3A8A; }
  .event-tag.amber { background: #FFF3E0; color: #9C6000; }
  .event-card-body h4 { font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; color: var(--ink); margin-bottom: 0.35rem; line-height: 1.3; }
  .event-card-body p { font-size: 0.82rem; color: var(--warm-gray); line-height: 1.55; }

  .feature-card { background: white; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; border-left: 4px solid var(--red); display: grid; grid-template-columns: 1fr 1fr; grid-column: span 3; margin-bottom: 0; }
  .feature-card .event-card-img { aspect-ratio: auto; min-height: 220px; }
  .feature-card .event-card-body { padding: 1.75rem; }
  .feature-card .event-card-body h4 { font-size: 1.2rem; margin-bottom: 0.6rem; }
  .feature-card .event-card-body p { margin-bottom: 0.75rem; }

  .about-section { background: var(--ink); padding: var(--section-gap) 4rem; display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
  .about-left h2 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 2.8vw, 3rem); color: white; line-height: 1.1; margin-bottom: 1.5rem; }
  .about-left h2 em { color: var(--red-mid); font-weight: 400; }
  .about-left p { font-size: 0.95rem; color: rgba(255,255,255,0.65); line-height: 1.8; margin-bottom: 1rem; }
  .about-left .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .about-left .tag { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.75); font-size: 0.78rem; padding: 0.4rem 1rem; border-radius: 100px; border: 1px solid rgba(255,255,255,0.12); }
  .edu-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 1.5rem 1.75rem; color: white; margin-bottom: 1rem; }
  .edu-card .edu-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--red-mid); margin-bottom: 0.5rem; }
  .edu-card h4 { font-size: 1.05rem; font-weight: 500; margin-bottom: 0.2rem; }
  .edu-card p { font-size: 0.85rem; color: rgba(255,255,255,0.5); }
  .cert-row { display: flex; gap: 1rem; margin-top: 0.5rem; flex-wrap: wrap; }
  .cert-pill { background: var(--ink); border: 1px solid rgba(255,255,255,0.15); color: white; padding: 0.65rem 1.25rem; border-radius: 100px; font-size: 0.8rem; font-weight: 500; display: flex; align-items: center; gap: 0.5rem; }
  .cert-pill span { color: var(--red-mid); }

  .uni-section { padding: var(--section-gap) 4rem; background: var(--red-light); }
  .modules-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .module-card { background: white; border: 1px solid rgba(139,26,26,0.15); border-radius: 14px; padding: 1.25rem; }
  .module-card h4 { font-size: 0.9rem; font-weight: 500; color: var(--ink); margin-bottom: 0.4rem; line-height: 1.35; }
  .module-card p { font-size: 0.78rem; color: var(--warm-gray); line-height: 1.55; }
  .module-highlight { border-left: 3px solid var(--red); }

  .contact-section { background: var(--red); padding: var(--section-gap) 4rem; display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
  .contact-section h2 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 2.8vw, 3rem); color: white; line-height: 1.1; margin-bottom: 1rem; }
  .contact-section h2 em { font-style: italic; font-weight: 400; opacity: 0.75; }
  .contact-section > div > p { font-size: 0.95rem; color: rgba(255,255,255,0.8); line-height: 1.7; margin-bottom: 2rem; }
  .contact-links { display: flex; flex-direction: column; gap: 1rem; }
  .contact-link { display: flex; align-items: center; gap: 1rem; text-decoration: none; transition: opacity 0.2s; }
  .contact-link:hover { opacity: 0.75; }
  .contact-link-icon { width: 44px; height: 44px; background: rgba(255,255,255,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1rem; color: white; flex-shrink: 0; }
  .contact-link-text p:first-child { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.6); }
  .contact-link-text p:last-child { font-size: 0.9rem; font-weight: 500; color: white; }
  .contact-form { display: flex; flex-direction: column; gap: 1rem; }
  .contact-form input, .contact-form textarea { background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25); border-radius: 12px; padding: 0.85rem 1.25rem; font-family: 'DM Sans', sans-serif; font-size: 0.88rem; color: white; outline: none; transition: border-color 0.2s; }
  .contact-form input::placeholder, .contact-form textarea::placeholder { color: rgba(255,255,255,0.5); }
  .contact-form input:focus, .contact-form textarea:focus { border-color: rgba(255,255,255,0.6); }
  .contact-form textarea { resize: vertical; min-height: 110px; }
  .contact-form button { background: var(--ink); color: white; border: none; border-radius: 100px; padding: 0.9rem 2rem; font-family: 'DM Sans', sans-serif; font-size: 0.88rem; font-weight: 500; cursor: pointer; transition: background 0.2s, transform 0.15s; align-self: flex-start; }
  .contact-form button:hover { background: #2D1010; transform: translateY(-1px); }

  footer { padding: 2rem 4rem; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); }
  footer p { font-size: 0.8rem; color: var(--warm-gray); }
  .footer-logo { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: var(--ink); }

  .upload-zone { border: 2px dashed var(--red-mid); border-radius: 16px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem; text-align: center; background: white; cursor: pointer; transition: background 0.2s; margin-top: 1.25rem; }
  .upload-zone:hover { background: var(--red-light); }
  .upload-zone p { font-size: 0.85rem; color: var(--red); font-weight: 500; }
  .upload-zone span { font-size: 0.75rem; color: var(--red-mid); margin-top: 0.25rem; display: block; }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  .hero-text { animation: fadeUp 0.7s ease both; }
  .hero-visual { animation: fadeUp 0.7s 0.15s ease both; }
  html { scroll-behavior: smooth; }
</style>
</head>
